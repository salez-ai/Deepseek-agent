{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/deepseek-agent/skill.schema.json",
  "title": "DeepSeek Agent skill manifest (skill.json), schema version 1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "description"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional: lets your editor offer completion and validation."
    },
    "schema": {
      "const": 1,
      "description": "Manifest format version. Always 1."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "Unique id. Lowercase letters, digits and '-'. Becomes the install folder name."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Human-readable name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$",
      "description": "Semantic version, e.g. 1.2.0."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "One or two sentences shown in the manager."
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "homepage": {
      "type": "string",
      "maxLength": 200
    },
    "license": {
      "type": "string",
      "maxLength": 200
    },
    "instructions": {
      "type": "string",
      "description": "Path (inside the package) to a UTF-8 text/markdown file with instructions for the AI."
    },
    "instructions_text": {
      "type": "string",
      "maxLength": 30000,
      "description": "Instructions for the AI written inline."
    },
    "tools": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/tool"
      }
    }
  },
  "not": {
    "required": [
      "instructions",
      "instructions_text"
    ]
  },
  "anyOf": [
    {
      "required": [
        "instructions"
      ]
    },
    {
      "required": [
        "instructions_text"
      ]
    },
    {
      "required": [
        "tools"
      ],
      "properties": {
        "tools": {
          "minItems": 1
        }
      }
    }
  ],
  "definitions": {
    "tool": {
      "type": "object",
      "required": [
        "name",
        "description",
        "exec"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$",
          "not": {
            "enum": [
              "list_dir",
              "read_file",
              "write_file",
              "replace_in_file",
              "delete_file",
              "search",
              "run_command",
              "generate_image"
            ]
          },
          "description": "What the AI writes after 'name:'. Must not clash with a built-in tool. Prefix it with your skill's topic to avoid clashes with other skills."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Tells the AI what the tool does and when to use it."
        },
        "params": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,40}$",
            "not": {
              "enum": [
                "name",
                "body"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/param"
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 300
            },
            "required": {
              "type": "boolean",
              "default": false
            }
          },
          "description": "Declare this if the tool takes multi-line text (the AI writes it between =====BODY===== and =====END=====)."
        },
        "exec": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Program followed by its arguments. No shell is used. Placeholders: {python} {skill_dir} {project_dir} and {parameter_name}."
        },
        "input": {
          "enum": [
            "json",
            "args"
          ],
          "default": "json",
          "description": "json: request sent on stdin as JSON. args: only the exec arguments are used; the body (if any) is sent on stdin."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900,
          "default": 60,
          "description": "Seconds before the process is killed."
        },
        "cwd": {
          "enum": [
            "project",
            "skill"
          ],
          "default": "project",
          "description": "Working directory of the process."
        },
        "risk": {
          "enum": [
            "read",
            "write",
            "exec"
          ],
          "default": "exec",
          "description": "read: only reads or queries. write: changes files or data. exec: runs programs, uses the network, or anything else. Be honest: it controls the approval prompt."
        }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "default": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "default": {
          "description": "Used when the AI leaves the parameter out. Not allowed together with required: true."
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Allowed values."
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Shown to the AI next to the parameter."
        }
      }
    }
  }
}
